      "cls": "text-[clamp(2rem,5vw,4rem)] font-light leading-[1] tracking-[-0.02em] opsz-72"
    },
    {
      "key": "item",
      "name": "ítem",
      "where": "h3",
      "cls": "text-[clamp(1.6rem,2.8vw,2.5rem)] font-light leading-[1.02] tracking-[-0.02em] opsz-72"
    },
    {
      "key": "bajada",
      "name": "bajada",
      "where": "subtítulo",
